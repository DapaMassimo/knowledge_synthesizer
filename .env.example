# OpenAI API key — used by the LLM provider (gpt-4o-mini) and OpenAI embeddings
# (text-embedding-3-small). Required only when those adapters are selected.
OPENAI_API_KEY=

# Embedding backend: "openai" (default) or "local" (multilingual-e5-small, offline).
KS_EMBEDDING_BACKEND=openai

# Persistent Chroma directory for dev. Leave empty to use an in-memory store.
KS_CHROMA_PATH=.chroma

# Directory where parsed DoclingDocuments are cached (keyed by content hash).
KS_DOCLING_CACHE_DIR=.cache/docling

# Offline PDF parsing: directory holding pre-downloaded Docling models (layout, tableformer,
# OCR). Download once with: uv run python -c "from docling.utils.model_downloader import
# download_models; download_models()" — they land in ~/.cache/docling/models. Leave empty to
# resolve models online on first PDF parse.
KS_DOCLING_ARTIFACTS_PATH=

# Run OCR during PDF parsing. true is safe for scanned PDFs; false is much faster for digital
# PDFs that already have embedded text.
KS_DOCLING_DO_OCR=true

# Default models, and the comma-separated lists shown in the UI dropdowns.
KS_LLM_MODEL=gpt-4o-mini
KS_EMBEDDING_MODEL=text-embedding-3-small
KS_LLM_MODELS=gpt-4o-mini,gpt-4o,gpt-4.1-mini,gpt-4.1
KS_EMBEDDING_MODELS=text-embedding-3-small,text-embedding-3-large
